{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run FastAPI App",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "chat-lang-local:app",
        "--reload",
        "--reload-dir=.",
        "--reload-exclude=venv",
        "--port=8000"
      ],
      "jinja": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal"
    }
  ]
}
